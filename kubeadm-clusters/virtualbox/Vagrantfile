# -*- mode: ruby -*-
# vi:set ft=ruby sw=2 ts=2 sts=2:

############################################
# Build configuration
############################################

BUILD_MODE = "BRIDGE"   # BRIDGE or NAT
NUM_WORKER_NODES = 2

IP_NW = "192.168.56"
MASTER_IP_START = 11
NODE_IP_START = 20

############################################
# Host OS detection
############################################

module OS
  def OS.windows?
    (/cygwin|mswin|mingw|bccwin|wince|emx/ =~ RUBY_PLATFORM) != nil
  end

  def OS.mac?
    (/darwin/ =~ RUBY_PLATFORM) != nil
  end

  def OS.linux?
    !OS.windows? && !OS.mac?
  end
end

############################################
# Helper methods
############################################

def get_bridge_adapter
  if OS.windows?
    %x{powershell -Command "Get-NetRoute -DestinationPrefix 0.0.0.0/0 | Get-NetAdapter | Select-Object -ExpandProperty InterfaceDescription"}.chomp
  elsif OS.linux?
    %x{ip route | grep default | awk '{ print $5 }'}.chomp
  elsif OS.mac?
    %x{mac/mac-bridge.sh}.chomp
  end
end

def get_machine_id(vm_name)
  id_path = ".vagrant/machines/#{vm_name}/virtualbox/id"
  File.exist?(id_path) ? File.read(id_path) : nil
end

def all_nodes_up
  return false if get_machine_id("controlplane").nil?
  (1..NUM_WORKER_NODES).each do |i|
    return false if get_machine_id("node0#{i}").nil?
  end
  true
end

############################################
# Provisioning helpers
############################################

def setup_dns(node)
  node.vm.provision "setup-hosts", type: "shell",
    path: "ubuntu/vagrant/setup-hosts.sh",
    args: [IP_NW, BUILD_MODE, NUM_WORKER_NODES, MASTER_IP_START, NODE_IP_START]

  node.vm.provision "setup-dns", type: "shell",
    path: "ubuntu/update-dns.sh"
end

def provision_kubernetes_node(node)
  setup_dns node
  node.vm.provision "setup-ssh", type: "shell", path: "ubuntu/ssh.sh"
end

############################################
# Vagrant configuration
############################################

Vagrant.configure("2") do |config|

  # 🔴 CRITICAL FIX: Disable VirtualBox shared folders
  # Prevents vboxsf race condition on macOS
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.box_check_update = false
  config.vm.boot_timeout = 900

  ##########################################
  # Host architecture detection
  ##########################################

  host_arch = `uname -m`.chomp

  if host_arch == "arm64" || host_arch == "aarch64"
    has_parallels = Vagrant.has_plugin?("vagrant-parallels")
    has_vmware    = Vagrant.has_plugin?("vagrant-vmware-desktop")

    if has_parallels
      config.vm.box = "bento/ubuntu-22.04"
      config.vm.provider :parallels do |p|
        p.memory = 2048
        p.cpus  = 2
      end
      puts "Using Parallels on Apple Silicon"

    elsif has_vmware
      config.vm.box = "bento/ubuntu-22.04"
      config.vm.provider :vmware_desktop do |v|
        v.vmx["memsize"]  = "2048"
        v.vmx["numvcpus"] = "2"
      end
      puts "Using VMware on Apple Silicon"

    else
      config.vm.box = "bento/ubuntu-22.04"
      puts <<~WARN
        WARNING:
        Apple Silicon detected but no Parallels/VMware plugin found.
        VirtualBox support on ARM is limited and may be unstable.
      WARN
    end
  else
    config.vm.box = "ubuntu/jammy64"
  end

  ##########################################
  # Control Plane
  ##########################################

  config.vm.define "controlplane" do |node|
    node.vm.hostname = "controlplane"

    node.vm.provider :virtualbox do |vb|
      vb.name   = "controlplane"
      vb.memory = 2048
      vb.cpus  = 2
    end

    if BUILD_MODE == "BRIDGE"
      node.vm.network :public_network, bridge: get_bridge_adapter
    else
      node.vm.network :private_network, ip: "#{IP_NW}.#{MASTER_IP_START}"
      node.vm.network :forwarded_port, guest: 22, host: 2710
    end

    provision_kubernetes_node node

    node.vm.provision "file", source: "./ubuntu/tmux.conf", destination: "$HOME/.tmux.conf"
    node.vm.provision "file", source: "./ubuntu/vimrc",     destination: "$HOME/.vimrc"
  end

  ##########################################
  # Worker Nodes
  ##########################################

  (1..NUM_WORKER_NODES).each do |i|
    config.vm.define "node0#{i}" do |node|
      node.vm.hostname = "node0#{i}"

      node.vm.provider :virtualbox do |vb|
        vb.name   = "node0#{i}"
        vb.memory = 1024
        vb.cpus  = 1
      end

      if BUILD_MODE == "BRIDGE"
        node.vm.network :public_network, bridge: get_bridge_adapter
      else
        node.vm.network :private_network, ip: "#{IP_NW}.#{NODE_IP_START + i}"
        node.vm.network :forwarded_port, guest: 22, host: 2720 + i
      end

      provision_kubernetes_node node
    end
  end

  ##########################################
  # Post-start trigger (BRIDGE only)
  ##########################################

  if BUILD_MODE == "BRIDGE"
    config.trigger.after :up do |trigger|
      trigger.ignore = [:destroy, :halt]

      trigger.ruby do
        if all_nodes_up
          puts "Gathering node IPs..."

          nodes = ["controlplane"] + (1..NUM_WORKER_NODES).map { |i| "node0#{i}" }
          ips   = nodes.map { |n| `vagrant ssh #{n} -c 'public-ip'`.chomp }

          File.open("hosts.tmp", "w") do |f|
            ips.each_with_index { |ip, i| f.puts "#{ip} #{nodes[i]}" }
          end

          nodes.each do |n|
            system("vagrant upload hosts.tmp /tmp/hosts.tmp #{n}")
            system("vagrant ssh #{n} -c 'sudo tee -a /etc/hosts < /tmp/hosts.tmp'")
          end

          File.delete("hosts.tmp")

          puts "\nVM build complete!\n"
          ips.drop(1).each { |ip| puts "  http://#{ip}:<NodePort>" }
          puts
        end
      end
    end
  end
end
